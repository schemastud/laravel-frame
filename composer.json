{
    "name": "schemastud/laravel-frame",
    "description": "The batteries-UX backend rung for schema-driven admin editors: the resource-definition registry (ResourceDefinition), the #[Widget] -> x-stud-widget projector, #[ReadOnlyField], and a served GET /frame/manifest. Sits one level above a filter-schema controller; resolves a resource key to its whole editor wiring. Pairs with @schemastud/frame on the JS side.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-popcorn": "dev-main",
        "rushing/php-popcorn": "dev-main",
        "schemastud/laravel-data-schemas": "dev-main",
        "spatie/laravel-data": "^4.9",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "spatie/laravel-typescript-transformer": "^3.3",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "rushing/laravel-data-filters": "Reuse a resource's data-filters query/filter schema for the ListShell facets bar.",
        "spatie/laravel-typescript-transformer": "Emit the ResourceDefinition TS type so the frontend manifest entry IS the backend projection."
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Schemastud\\Frame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schemastud\\Frame\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schemastud\\Frame\\FrameServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/phpunit"
    }
}
